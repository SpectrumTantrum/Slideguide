# SlideGuide Environment Configuration

# ── OpenAI-compatible endpoint ───────────────────────────────────────────────
# SlideGuide talks to ONE OpenAI-compatible /v1 API that you choose: real
# OpenAI, Ollama, vLLM, LocalAI, OpenRouter, LM Studio, Together, Groq, or any
# self-hosted gateway. OPENAI_API_KEY may be left empty for endpoints that
# don't require auth (a placeholder is sent so the OpenAI SDK still initializes).
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# Model names served by your endpoint.
# NOTE: EMBEDDING_MODEL must return 1536-dimensional vectors (pgvector schema).
PRIMARY_MODEL=gpt-4o-mini            # any chat model your endpoint serves
ROUTING_MODEL=                       # optional; falls back to PRIMARY_MODEL
EMBEDDING_MODEL=text-embedding-3-small
VISION_MODEL=                        # optional; leave empty to disable vision

# ── Supabase ───────────────────────────────────────────────────────────────────
# Copy these from the output of `supabase start`
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-key            # reserved for future frontend auth
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Tesseract OCR ────────────────────────────────────────────────────────────
TESSERACT_CMD=tesseract

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=SlideGuide
APP_URL=https://github.com/yourusername/slideguide
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# ── Cost Control ─────────────────────────────────────────────────────────────
MAX_TOKENS_PER_SESSION=100000
MAX_UPLOAD_SIZE_MB=50
