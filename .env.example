# SlideGuide Environment Configuration

# ── Chat provider SDK ────────────────────────────────────────────────────────
# openai  = official OpenAI SDK against OPENAI_BASE_URL (that endpoint's bill)
# cursor  = official cursor-sdk (bills chat to your Cursor subscription)
# Process default for new sessions. The session banner preference is stored
# in the browser and applied per session (never a process-wide override).
# On the Cursor route, grok-4.6 at high effort is preferred first.
LLM_PROVIDER=openai

# Cursor SDK — https://cursor.com/dashboard/api
# Required to bill tutoring chat to Cursor usage.
CURSOR_API_KEY=
CURSOR_RUNTIME=local          # tutoring requires local (cloud is refused)
CURSOR_MODEL=                 # optional; defaults to grok-4.6
CURSOR_REASONING_EFFORT=high  # low | medium | high | xhigh (Grok only)
CURSOR_WORKSPACE=             # optional root; each session gets its own subdir

# ── OpenAI-compatible endpoint ───────────────────────────────────────────────
# Used for embeddings always, and for chat when LLM_PROVIDER=openai.
# Point at any OpenAI-compatible /v1 API: real OpenAI, Ollama, vLLM, LocalAI,
# OpenRouter, LM Studio, Together, Groq, or a self-hosted gateway.
# OPENAI_API_KEY may be left empty for endpoints that don't require auth.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# Model names served by your endpoint.
# NOTE: EMBEDDING_MODEL must return 1536-dimensional vectors (pgvector schema).
PRIMARY_MODEL=gpt-4o-mini            # any chat model your endpoint serves
ROUTING_MODEL=                       # optional; falls back to PRIMARY_MODEL
EMBEDDING_MODEL=text-embedding-3-small
VISION_MODEL=                        # optional; leave empty to disable vision

# ── Supabase ───────────────────────────────────────────────────────────────────
# Copy these from the output of `supabase start`
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-key            # reserved for future frontend auth
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Tesseract OCR ────────────────────────────────────────────────────────────
TESSERACT_CMD=tesseract

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=SlideGuide
APP_URL=https://github.com/yourusername/slideguide
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# ── Cost Control ─────────────────────────────────────────────────────────────
MAX_TOKENS_PER_SESSION=100000
MAX_UPLOAD_SIZE_MB=50
