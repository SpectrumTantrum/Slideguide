# SlideGuide Environment Configuration

# ── Provider Selection ───────────────────────────────────────────────────────
# Which backend to use for each capability. Options per variable:
#   "openrouter" (hosted gateway) | "lmstudio" (local) | "openai" (custom endpoint)
LLM_PROVIDER=openrouter
EMBEDDING_PROVIDER=openrouter
VISION_PROVIDER=openrouter

# ── OpenRouter API (LLM gateway, embeddings, and chat) ───────────────────────
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── LM Studio (local models) ────────────────────────────────────────────────
# Leave model fields empty to auto-discover from LM Studio
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_PRIMARY_MODEL=              # auto-discovered if empty
LMSTUDIO_ROUTING_MODEL=              # falls back to primary if empty
LMSTUDIO_EMBEDDING_MODEL=            # auto-discovered if empty

# ── Generic OpenAI-compatible provider (used when a provider is set to "openai")
# Point this at ANY OpenAI-compatible /v1 endpoint and pick your own models:
# real OpenAI, Ollama, vLLM, LocalAI, Together, Groq, a self-hosted gateway, etc.
# OPENAI_API_KEY may be left empty for endpoints that don't require auth.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_PRIMARY_MODEL=                # e.g. gpt-4o-mini, llama3.1:8b, etc.
OPENAI_ROUTING_MODEL=               # falls back to primary if empty
OPENAI_EMBEDDING_MODEL=              # e.g. text-embedding-3-small, nomic-embed-text
OPENAI_VISION_MODEL=                # e.g. gpt-4o (leave empty if not using vision)

# ── Model Configuration (OpenRouter format, used when LLM_PROVIDER=openrouter)
PRIMARY_MODEL=anthropic/claude-sonnet-4
ROUTING_MODEL=anthropic/claude-haiku-4
VISION_MODEL=anthropic/claude-sonnet-4
FALLBACK_MODEL=deepseek/deepseek-chat-v3
EMBEDDING_MODEL=openai/text-embedding-3-small

# ── Supabase ───────────────────────────────────────────────────────────────────
# Copy these from the output of `supabase start`
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-key            # reserved for future frontend auth
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Tesseract OCR ────────────────────────────────────────────────────────────
TESSERACT_CMD=tesseract

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=SlideGuide
APP_URL=https://github.com/yourusername/slideguide
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# ── Cost Control ─────────────────────────────────────────────────────────────
MAX_TOKENS_PER_SESSION=100000
MAX_UPLOAD_SIZE_MB=50
